SymptoTrack Pro - Standalone Naive Bayes Medical Classifier
Pure Python Implementation (Runs in VS Code Terminal with 0 dependencies)
"""
import sys
import math
import json
# Ensure UTF-8 output encoding for Windows terminal compatibility
if sys.platform == 'win32':
sys.stdout.reconfigure(encoding='utf-8')
class NaiveBayesMedicalClassifier:
def __init__(self):
self.class_priors = {}
self.feature_likelihoods = {}
self.vocabulary = set()
# Load dataset
with open("master_symptom_disease_dataset.json", "r", encoding="utf-8") as f:
self.corpus = json.load(f)
self.train()
def train(self):
