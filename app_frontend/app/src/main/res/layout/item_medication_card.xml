<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@color/card_white"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_heart_pulse"
            app:tint="@color/primary_blue"
            android:background="@drawable/bg_circle_icon"
            android:padding="8dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <TextView
                android:id="@+id/tv_med_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Amoxicillin 500mg"
                android:textColor="@color/text_primary_dark"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_med_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="8:00 AM • After Food"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_taken_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Taken ✓"
            android:textColor="@color/accent_green"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/bg_status_badge"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_take_action"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Take Now"
            android:textSize="12sp"
            android:textColor="@color/card_white"
            android:backgroundTint="@color/primary_blue"
            android:paddingHorizontal="14dp" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
