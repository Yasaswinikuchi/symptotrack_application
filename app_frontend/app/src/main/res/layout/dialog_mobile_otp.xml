<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_premium_gradient"
    android:padding="24dp">

    <!-- Header Icon + Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_phone"
            app:tint="@color/brand_blue"
            android:background="@drawable/bg_circle_icon"
            android:padding="10dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <TextView
                android:id="@+id/tv_otp_dialog_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mobile Verification"
                android:textColor="@color/brand_dark"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_otp_dialog_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enter your phone number to receive a 6-digit OTP"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- STEP 1: Phone Number Entry -->
    <LinearLayout
        android:id="@+id/layout_step_phone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Clean Phone Input Container (No side bar line) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_input"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:layout_marginBottom="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🇮🇳 +91"
                android:textColor="@color/brand_dark"
                android:textSize="15sp"
                android:textStyle="bold"
                android:paddingEnd="10dp" />

            <EditText
                android:id="@+id/et_phone_number"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:hint="98765 43210"
                android:inputType="phone"
                android:maxLength="10"
                android:background="@android:color/transparent"
                android:textColor="@color/brand_dark"
                android:textColorHint="@color/text_hint"
                android:textSize="16sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_send_otp"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Get OTP via SMS"
            android:textColor="@color/white"
            android:backgroundTint="@color/brand_blue"
            android:textStyle="bold"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- STEP 2: 6-Digit OTP Boxes Input -->
    <LinearLayout
        android:id="@+id/layout_step_verify"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- 6 Separate Digit Boxes -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp">

            <EditText
                android:id="@+id/otp_box_1"
                android:layout_width="44dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_input"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:textColor="@color/brand_dark"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginEnd="6dp" />

            <EditText
                android:id="@+id/otp_box_2"
                android:layout_width="44dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_input"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:textColor="@color/brand_dark"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginEnd="6dp" />

            <EditText
                android:id="@+id/otp_box_3"
                android:layout_width="44dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_input"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:textColor="@color/brand_dark"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginEnd="6dp" />

            <EditText
                android:id="@+id/otp_box_4"
                android:layout_width="44dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_input"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:textColor="@color/brand_dark"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginEnd="6dp" />

            <EditText
                android:id="@+id/otp_box_5"
                android:layout_width="44dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_input"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:textColor="@color/brand_dark"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginEnd="6dp" />

            <EditText
                android:id="@+id/otp_box_6"
                android:layout_width="44dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_input"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:textColor="@color/brand_dark"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Verify Button -->
        <Button
            android:id="@+id/btn_verify_otp"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Verify &amp; Continue"
            android:textColor="@color/white"
            android:backgroundTint="@color/accent_green"
            android:textStyle="bold"
            android:textSize="15sp" />

        <!-- Resend Countdown Timer -->
        <TextView
            android:id="@+id/tv_resend_otp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Resend OTP in 30s"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:gravity="center"
            android:paddingTop="14dp"
            android:paddingBottom="4dp" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_cancel_otp"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="Cancel"
        android:textColor="@color/text_secondary"
        android:backgroundTint="@color/slate_100"
        android:layout_marginTop="10dp" />

</LinearLayout>
