<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_family_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/card_white"
    android:layout_marginBottom="14dp"
    android:foreground="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Top row: avatar + name/details + action buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Avatar circle -->
            <ImageView
                android:id="@+id/iv_member_icon"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:src="@drawable/ic_user"
                app:tint="@color/accent_purple"
                android:background="@drawable/bg_circle_icon"
                android:padding="10dp" />

            <!-- Name + details -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/tv_member_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Family Member"
                    android:textColor="@color/text_primary_dark"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_member_details"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Age • Gender • Blood"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:id="@+id/tv_member_conditions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Conditions: None"
                    android:textColor="@color/slate_600"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- EDIT button – prominent pencil icon -->
            <ImageButton
                android:id="@+id/btn_edit_member"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/ic_settings"
                app:tint="@color/brand_blue"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Edit member"
                android:layout_marginEnd="2dp" />

            <!-- DELETE button -->
            <ImageButton
                android:id="@+id/btn_delete_member"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/ic_delete"
                app:tint="@color/error_red"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Delete member" />

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#12000000"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="6dp" />

        <!-- Tap hint row -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✏️  Tap anywhere on card to edit"
            android:textColor="@color/brand_blue"
            android:textSize="11sp"
            android:gravity="center" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
