<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_premium_gradient"
    android:padding="24dp">

    <TextView
        android:id="@+id/tv_dialog_hospital_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Book Appointment"
        android:textColor="@color/brand_dark"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="18dp"
        android:gravity="center" />

    <!-- Label 1: Describe problem -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Describe your problem"
        android:textColor="@color/brand_dark"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/et_problem_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="E.g., Fever and headache..."
        android:textColor="@color/brand_dark"
        android:textColorHint="@color/text_hint"
        android:textSize="14sp"
        android:padding="14dp"
        android:background="@drawable/bg_input"
        android:lines="3"
        android:gravity="top|start"
        android:layout_marginBottom="16dp" />

    <!-- Label 2: Appointment Date -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Appointment Date"
        android:textColor="@color/brand_dark"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_pick_date"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Select Date"
        android:textAllCaps="false"
        app:backgroundTint="@color/slate_100"
        android:textColor="@color/brand_dark"
        android:textSize="15sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"
        app:icon="@drawable/ic_bell"
        app:iconTint="@color/brand_blue" />

    <!-- Label 3: Available Slot Time -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Available slot time"
        android:textColor="@color/brand_dark"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <Spinner
        android:id="@+id/spinner_time_slot"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:paddingHorizontal="14dp"
        android:background="@drawable/bg_input"
        android:layout_marginBottom="24dp" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2">

        <Button
            android:id="@+id/btn_cancel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="CANCEL"
            android:backgroundTint="@color/slate_100"
            android:textColor="@color/brand_dark"
            android:textStyle="bold"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btn_proceed"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="PAY (₹500)"
            android:backgroundTint="@color/brand_blue"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:layout_marginStart="8dp" />
    </LinearLayout>

</LinearLayout>
